# Postgres connection string. Required — the server will not start without it.
# This is a SEPARATE database from the verification service's — a fresh Neon
# project/branch, not a shared one (see README "Independence from the
# verification service").
DATABASE_URL=

# Public base URL this service is reachable at, used to build absolute URLs in
# the /.well-known discovery manifest. Required — the server will not start
# without it. Locally: http://127.0.0.1:8200. In production: your real
# Render URL.
SERVICE_BASE_URL=

# --- Wallet-signature auth (PATCH/DELETE) ------------------------------------
# How many seconds old a signed request may be before it's rejected (bounds
# the replay window; a used (wallet, nonce) pair is also rejected outright
# within this same window — see app/core/wallet_auth.py).
# SIGNATURE_MAX_AGE_SECONDS=300

# --- Rate limiting (spam prevention) -----------------------------------------
# POST /listings: per-client-IP limit, plus a hard global daily ceiling that
# bounds total listings/day even if per-IP limits are bypassed via a spoofed
# client address (same known, accepted limitation as the verification
# service — see README "Security review").
# LISTING_CREATE_RATE_LIMIT_MAX_REQUESTS=5
# LISTING_CREATE_RATE_LIMIT_WINDOW_SECONDS=60
# LISTING_CREATE_GLOBAL_DAILY_CAP=1000
# PATCH/DELETE /listings/{id}: a looser limit — the real gate there is the
# wallet signature, this just stops wasted compute from garbage attempts.
# LISTING_MUTATE_RATE_LIMIT_MAX_REQUESTS=30
# LISTING_MUTATE_RATE_LIMIT_WINDOW_SECONDS=60
# LISTING_MUTATE_GLOBAL_DAILY_CAP=5000
# The search_listings MCP tool (see README "MCP access path"): free, so this is
# the only thing throttling it instead of a payment gate.
# MCP_SEARCH_RATE_LIMIT_MAX_REQUESTS=30
# MCP_SEARCH_RATE_LIMIT_WINDOW_SECONDS=60
# MCP_SEARCH_GLOBAL_DAILY_CAP=10000

# Requests are capped at this many bytes and rejected with 413 before parsing.
# MAX_REQUEST_BODY_BYTES=65536

# --- Trust-score badges (see README "Trust score badges") -------------------
# The verification service this board looks up badges from.
# VERIFICATION_SERVICE_URL=https://fastapi-service-5ag4.onrender.com
# How long a fetched score is reused before looking it up again.
# BADGE_CACHE_TTL_SECONDS=300
#
# UNSET BY DEFAULT, ON PURPOSE. GET /score/{agent_id} on the verification
# service costs $0.01 USDC per call with no free tier over REST, so badges are
# a real recurring cost, not a free feature. Leaving this unset (the shipped
# default) disables badge lookups entirely — no network calls, no spend — and
# every listing simply has badge: null. Listing creation and every other flow
# works fully either way; badges are additive, never required.
# To enable: fund a small, DEDICATED wallet with a little USDC on Base mainnet
# (never reuse a wallet holding anything else) and set:
# BOARD_PAYER_PRIVATE_KEY=0x...
